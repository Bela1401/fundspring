{
  "name": "fundspring",
  "version": "0.1.0",
  "private": true,
  "description": "FundSpring is an independent all-or-nothing USDC crowdfunding application built on Arc Network.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:contracts": "forge fmt --check",
    "test:contracts": "forge test -vvv",
    "test:frontend": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:frontend && npm run build"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "1.14.1",
    "@circle-fin/app-kit": "1.11.0",
    "@openzeppelin/contracts": "5.6.1",
    "@tanstack/react-query": "5.101.4",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.10",
    "wagmi": "3.7.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "20.19.33",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.1.18",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "20.x"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
